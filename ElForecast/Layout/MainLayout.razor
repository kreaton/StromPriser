@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav

<div class="shell">
    <header class="topbar">
        <a class="brand" href="">
            <img src="icons/icon-192.png" width="28" height="28" alt="" />
            ElForecast
        </a>
        <nav>
            @* Plain links: NavLink ignores the query string, so it can't tell the two views apart. *@
            <a href="" class="@(InSetup ? null : "active")">Prognose</a>
            <a href="?vis=opsaetning" class="@(InSetup ? "active" : null)">Opsætning</a>
        </nav>
    </header>

    <main>
        @Body
    </main>

    <footer class="footer">
        <span>@AppInfo.Copyright</span>
        <span>Data: <a href="https://stromligning.dk" target="_blank" rel="noopener">stromligning.dk</a></span>
        <span>Version @AppInfo.Version</span>
    </footer>
</div>

@code {
    private bool InSetup => new Uri(Nav.Uri).Query.Contains("vis=opsaetning", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
