@page "/"
@using ElForecast.Components
@using ElForecast.Services
@using Stromligning
@implements IDisposable
@inject PriceService Prices
@inject CatalogService Catalog
@inject SetupStore Store

@if (ShowSetup)
{
    <SetupForm />
    return;
}

<PageTitle>El Forecast</PageTitle>

@if (_setup is null)
{
    <p class="muted">Indlæser…</p>
}
else if (!_setup.IsComplete)
{
    <section class="empty">
        <h1>Elprisprognose</h1>
        <p>Se din forventede elpris time for time cirka en uge frem – spotprisprognosen lagt sammen
           med dit netselskabs tariffer, afgifter og din elaftales tillæg.</p>
        <a class="btn primary" href="?vis=opsaetning">Kom i gang – vælg dit netselskab</a>
    </section>
}
else
{
    <div class="page-head">
        <div>
            <h1>@Headline</h1>
            @if (_result?.ForecastGeneratedAt is { } g)
            {
                <p class="muted">@($"Lavet {g.ToLocalTime():ddd d. MMM 'kl.' HH':'mm}")</p>
            }
            <p class="muted">
                @(_supplierName ?? _setup.SupplierId)@(_priceArea is null ? "" : $" · {_priceArea}")
                · @(_setup.CompanyName ?? "kun spotpris uden tillæg")
                · <a href="?vis=opsaetning">skift</a>
            </p>
        </div>
        <button class="btn" @onclick="LoadAsync" disabled="@_loading">@(_loading ? "Henter…" : "Opdater")</button>
    </div>

    @if (_error is not null)
    {
        <div class="notice error" role="alert">Kunne ikke hente priserne: @_error</div>
    }

    @if (_result is not null)
    {
        @if (_result.ForecastError is { } fe)
        {
            <div class="notice warn" role="status">Prognosen kunne ikke hentes (@fe.Message) – kun offentliggjorte priser vises.</div>
        }

        <section class="card">
            <PriceChart Rows="_result.Rows" IncludeVat="_setup.IncludeVat" HighlightUntil="_nearUntil" />
        </section>

        <div class="tiles">
            @foreach (var w in _windows)
            {
                <div class="tile">
                    <span class="tile-label">Billigste 2 timer · @w.Label</span>
                    @if (w.Start is { } start)
                    {
                        <span class="tile-value">@w.Average.ToString("0.00") kr</span>
                        <span class="tile-sub">
                            kl. @start.ToString("HH':'mm")–@start.AddHours(WindowHours).ToString("HH':'mm")
                            · @StartsIn(start)@(w.IsForecast ? " (prognose)" : "")
                        </span>
                    }
                    else
                    {
                        <span class="tile-value">–</span>
                        <span class="tile-sub">ingen priser</span>
                    }
                </div>
            }
        </div>

        <p class="muted small">
            Priser i kr/kWh. Efter de offentliggjorte priser bygger prognosetimerne på
            stromligning.dk's spotprisprognose plus 25 % moms; tariffer, tillæg og elafgift er
            kopieret fra seneste offentliggjorte time på samme klokkeslæt.
        </p>
    }
    else if (_loading)
    {
        <p class="muted">Henter priser og prognose…</p>
    }
}

@code {
    // The setup lives on the same page behind "?vis=opsaetning" rather than on its own route,
    // so a reload works on a plain static (FTP) host with no fallback to index.html.
    [SupplyParameterFromQuery(Name = "vis")] public string? View { get; set; }

    private bool ShowSetup => string.Equals(View, "opsaetning", StringComparison.OrdinalIgnoreCase);

    private ForecastSetup? _setup;
    private string? _loadedFor;
    private PriceResult? _result;

    // The chart highlights today and the next two days: further out the forecast is too
    // uncertain to plan by.
    private const int NearDays = 3;
    private DateTime _nearUntil;

    // Cheapest consecutive block of this many hours within each window.
    private const int WindowHours = 2;
    private sealed record CheapWindow(string Label, DateTime? Start, double Average, bool IsForecast);
    private List<CheapWindow> _windows = new();
    private string? _supplierName;
    private string? _priceArea;
    private string? _error;
    private bool _loading;
    private CancellationTokenSource? _cts;

    // Runs again when coming back from the setup, so a changed selection is fetched.
    protected override async Task OnParametersSetAsync()
    {
        if (ShowSetup)
            return;

        _setup = await Store.LoadAsync();
        var key = $"{_setup.SupplierId}|{_setup.CustomerGroupId}|{_setup.ProductId}";
        if (_setup.IsComplete && key != _loadedFor)
        {
            _loadedFor = key;
            _result = null;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        if (_setup is not { IsComplete: true })
            return;

        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;
        _loading = true;
        _error = null;

        try
        {
            var query = new PriceQuery(_setup.SupplierId!, _setup.CustomerGroupId, _setup.ProductId)
            {
                Hourly = true,
                IncludeForecast = true
            };
            _result = await Prices.GetPricesAsync(query, ct);
            _priceArea = _result.PriceArea;
            _nearUntil = DateTime.Today.AddDays(NearDays);
            _windows = BuildWindows(_result.Rows, DateTime.Now);

            try
            {
                _supplierName = (await Catalog.GetSuppliersAsync()).FirstOrDefault(s => s.Id == _setup.SupplierId)?.Name;
            }
            catch
            {
                // The name is only cosmetic; the id is shown instead.
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            if (!ct.IsCancellationRequested)
                _loading = false;
        }
    }

    // "Elprisprognose til 2026-11-19 (7 dage)" – the last day with a price, and how far the
    // forecast reaches.
    private string Headline
    {
        get
        {
            if (_result is not { Rows.Count: > 0 } r)
                return "Elprisprognose";
            var last = r.Rows[^1].Start.ToString("yyyy-MM-dd");
            var days = (int)Math.Round(r.ForecastCount / 24.0);
            return days > 0
                ? $"Elprisprognose til {last} ({(days == 1 ? "1 dag" : $"{days} dage")})"
                : $"Elprisprognose til {last}";
        }
    }

    // Now until midnight, then tomorrow night and tomorrow daytime.
    private static List<CheapWindow> BuildWindows(IReadOnlyList<PriceRow> rows, DateTime now)
    {
        var tomorrow = now.Date.AddDays(1);
        return new List<CheapWindow>
        {
            Cheapest("nu–00:00", rows, now, tomorrow),
            Cheapest("i nat 00–06", rows, tomorrow, tomorrow.AddHours(6)),
            Cheapest("i morgen 06–18", rows, tomorrow.AddHours(6), tomorrow.AddHours(18))
        };
    }

    // Cheapest run of WindowHours consecutive hourly rows lying within [from, to). The hour
    // already under way counts, so a block can start "nu".
    private static CheapWindow Cheapest(string label, IReadOnlyList<PriceRow> rows, DateTime from, DateTime to)
    {
        var inRange = rows.Where(r => r.End > from && r.End <= to).OrderBy(r => r.Start).ToList();
        CheapWindow best = new(label, null, 0, false);

        for (var i = 0; i + WindowHours <= inRange.Count; i++)
        {
            var block = inRange.GetRange(i, WindowHours);
            var contiguous = block.Zip(block.Skip(1)).All(p => p.First.End == p.Second.Start);
            if (!contiguous)
                continue;

            var avg = block.Average(r => r.Total.Total);
            if (best.Start is null || avg < best.Average)
                best = new(label, block[0].Start, avg, block.Any(r => r.IsForecast));
        }

        return best;
    }

    private static string StartsIn(DateTime start)
    {
        var wait = start - DateTime.Now;
        if (wait <= TimeSpan.Zero)
            return "i gang nu";
        var hours = (int)wait.TotalHours;
        return hours == 0 ? $"om {wait.Minutes} min" : $"om {hours} t {wait.Minutes} min";
    }

    public void Dispose() => _cts?.Cancel();
}
