@using Stromligning

@* Stacked bars, one per hour: each bar is split into the price components, with the spot
   price at the bottom because that is the part that moves. Gridlines every 0.5 kr. The plot
   scrolls sideways when the hours do not fit; the price axis stays put on the left. *@

<div class="legend" aria-label="Forklaring">
    @for (var i = 0; i < Parts.Length; i++)
    {
        <span class="legend-item"><span class="swatch @Parts[i].Css"></span>@Parts[i].Label</span>
    }
    @if (_forecastStart >= 0)
    {
        <span class="legend-item"><span class="swatch s1 forecast"></span>Prognose (lysere)</span>
    }
    <span class="legend-unit">kr/kWh @(IncludeVat ? "inkl." : "ekskl.") moms</span>
</div>

<div class="chart" style="--plot-top:@(Top)px; --plot-height:@(PlotHeight)px; --x-axis:@(XAxis)px;">
    <div class="y-axis" aria-hidden="true">
        @foreach (var v in _ticks)
        {
            <span class="tick" style="top:@Px(Y(v))">@v.ToString("0.0")</span>
        }
    </div>

    <div class="scroller" tabindex="0" aria-label="Pris pr. time – rul vandret for flere timer" @onscroll="ClearHover">
        <div class="plot" style="width:@Px(Width)" @onmouseleave="ClearHover">
            @foreach (var v in _ticks)
            {
                <div class="grid @(v == 0 ? "zero" : null)" style="top:@Px(Y(v))"></div>
            }

            @foreach (var i in _midnights)
            {
                <div class="day-line" style="left:@Px(i * Step - 1)"></div>
            }

            @if (_forecastStart >= 0)
            {
                <div class="forecast-line" style="left:@Px(_forecastStart * Step - 1)"></div>
                <div class="forecast-label" style="left:@Px(_forecastStart * Step + 4)">Prognose →</div>
            }

            @for (var i = 0; i < _bars.Count; i++)
            {
                var bar = _bars[i];
                var index = i;
                <div class="bar @(bar.Row.IsForecast ? "forecast" : null) @(index == _hover ? "hover" : null)"
                     style="left:@Px(index * Step)"
                     @onmouseenter="e => Hover(index, e)"
                     @onclick="e => Hover(index, e)">
                    @foreach (var seg in bar.Segments)
                    {
                        <div class="seg @Parts[seg.Part].Css @(seg.IsTop ? "top" : null)"
                             style="top:@Px(seg.Top); height:@Px(seg.Height)"></div>
                    }
                </div>
            }

            @foreach (var (index, text) in _callouts)
            {
                <div class="callout" style="left:@Px(index * Step + Step / 2.0); top:@Px(_bars[index].TopY - 18)">@text</div>
            }
        </div>

        <div class="x-axis" style="width:@Px(Width)" aria-hidden="true">
            @for (var i = 0; i < _bars.Count; i++)
            {
                var start = _bars[i].Row.Start;
                if (start.Hour % 3 == 0)
                {
                    <span class="hour" style="left:@Px(i * Step + Step / 2.0)">@start.ToString("HH")</span>
                }
                if (i == 0 || start.Hour == 0)
                {
                    <span class="date" style="left:@Px(i * Step + 2)">@start.ToString("ddd d. MMM")</span>
                }
            }
        </div>
    </div>
</div>

@if (_hover >= 0 && _hover < _bars.Count)
{
    var row = _bars[_hover].Row;
    <div class="tooltip" role="status"
         style="left:min(@Px(_tipX + 16), calc(100vw - 280px)); top:max(8px, min(@Px(_tipY - 40), calc(100vh - 330px)));">
        <div class="tip-head">
            <strong>@row.Start.ToString("dddd d. MMMM")</strong>
            <span>@row.Start.ToString("HH':'mm")–@row.End.ToString("HH':'mm")</span>
        </div>
        <div class="tip-kind @(row.IsForecast ? "forecast" : null)">@(row.IsForecast ? "Prognose – estimeret pris" : "Offentliggjort pris")</div>
        <table>
            <tbody>
                @for (var p = Parts.Length - 1; p >= 0; p--)
                {
                    <tr>
                        <td><span class="swatch @Parts[p].Css"></span>@Parts[p].Label</td>
                        <td class="num">@Kr(Pick(Parts[p].Get(row)))</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr><td>I alt ekskl. moms</td><td class="num">@Kr(row.Total.ExVat)</td></tr>
                <tr><td>Moms</td><td class="num">@Kr(row.Total.Vat)</td></tr>
                <tr class="total"><td>I alt inkl. moms</td><td class="num">@Kr(row.Total.Total)</td></tr>
            </tfoot>
        </table>
        <div class="tip-note">Komponenterne er vist @(IncludeVat ? "inkl." : "ekskl.") moms, kr/kWh.</div>
    </div>
}

<details class="table-view">
    <summary>Vis som tabel</summary>
    <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>Tid</th>
                    @foreach (var part in Parts)
                    {
                        <th class="num">@part.Label</th>
                    }
                    <th class="num">I alt inkl. moms</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bar in _bars)
                {
                    <tr class="@(bar.Row.IsForecast ? "forecast" : null)">
                        <td>@bar.Row.Start.ToString("ddd d/M HH':'mm")@(bar.Row.IsForecast ? " *" : "")</td>
                        @foreach (var part in Parts)
                        {
                            <td class="num">@Pick(part.Get(bar.Row)).ToString("0.000")</td>
                        }
                        <td class="num"><strong>@bar.Row.Total.Total.ToString("0.000")</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="muted">* prognose. Komponenter @(IncludeVat ? "inkl." : "ekskl.") moms, kr/kWh.</p>
</details>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PriceRow> Rows { get; set; } = [];

    /// <summary>Stack each component incl. VAT; otherwise ex. VAT.</summary>
    [Parameter] public bool IncludeVat { get; set; } = true;

    /// <summary>Only hours starting before this get the cheapest/priciest marks; default means all.</summary>
    [Parameter] public DateTime HighlightUntil { get; set; }

    private const double Step = 16;        // px per hour: 14px bar + 2px gap
    private const double Top = 30;         // room above the plot for callouts
    private const double PlotHeight = 320;
    private const double XAxis = 44;
    private const double GridStep = 0.5;   // kr between gridlines

    private sealed record Part(string Label, string Css, Func<PriceRow, Money> Get);

    private static readonly Part[] Parts =
    [
        new("Spotpris", "s1", r => r.Electricity),
        new("Tillæg", "s2", r => r.Surcharge),
        new("Nettarif", "s3", r => r.NetTariff),
        new("Systemtarif", "s4", r => r.SystemTariff),
        new("Distribution", "s5", r => r.Distribution),
        new("Elafgift", "s6", r => r.ElectricityTax)
    ];

    private sealed record Segment(int Part, double Top, double Height, bool IsTop);
    private sealed record Bar(PriceRow Row, List<Segment> Segments, double TopY);

    private List<Bar> _bars = [];
    private List<double> _ticks = [];
    private List<int> _midnights = [];
    private List<(int Index, string Text)> _callouts = [];
    private int _forecastStart = -1;
    private double _yMin, _yMax;

    private int _hover = -1;
    private double _tipX, _tipY;

    private double Width => _bars.Count * Step;

    protected override void OnParametersSet()
    {
        _hover = -1;

        // Positive parts stack up from zero, negative ones (a negative spot price) down from it.
        var highs = Rows.Select(r => Parts.Sum(p => Math.Max(0, Pick(p.Get(r))))).ToList();
        var lows = Rows.Select(r => Parts.Sum(p => Math.Min(0, Pick(p.Get(r))))).ToList();
        _yMax = Math.Max(GridStep, Math.Ceiling((highs.DefaultIfEmpty(0).Max() + 0.01) / GridStep) * GridStep);
        _yMin = Math.Floor(lows.DefaultIfEmpty(0).Min() / GridStep) * GridStep;

        _ticks = [];
        for (var v = _yMin; v <= _yMax + 1e-9; v += GridStep)
            _ticks.Add(Math.Round(v, 2));

        _bars = Rows.Select(BuildBar).ToList();
        _midnights = Enumerable.Range(1, Math.Max(0, Rows.Count - 1)).Where(i => Rows[i].Start.Hour == 0).ToList();
        _forecastStart = Rows.Select((r, i) => r.IsForecast ? i : -1).FirstOrDefault(i => i >= 0, -1);

        _callouts = [];
        var candidates = Enumerable.Range(0, Rows.Count)
            .Where(i => HighlightUntil == default || Rows[i].Start < HighlightUntil)
            .ToList();
        if (candidates.Count > 1)
        {
            var cheapest = candidates.MinBy(i => Rows[i].Total.Total);
            var priciest = candidates.MaxBy(i => Rows[i].Total.Total);
            _callouts.Add((cheapest, "▼ " + Rows[cheapest].Total.Total.ToString("0.00")));
            _callouts.Add((priciest, "▲ " + Rows[priciest].Total.Total.ToString("0.00")));
        }
    }

    private Bar BuildBar(PriceRow row)
    {
        var segments = new List<Segment>();
        double up = 0, down = 0;
        var topIndex = -1;

        for (var p = 0; p < Parts.Length; p++)
        {
            var value = Pick(Parts[p].Get(row));
            if (value > 0)
            {
                segments.Add(new Segment(p, Y(up + value), Y(up) - Y(up + value), false));
                up += value;
                topIndex = segments.Count - 1;
            }
            else if (value < 0)
            {
                segments.Add(new Segment(p, Y(down), Y(down + value) - Y(down), false));
                down += value;
            }
        }

        if (topIndex >= 0)
            segments[topIndex] = segments[topIndex] with { IsTop = true };

        return new Bar(row, segments, Y(up));
    }

    private double Pick(Money m) => IncludeVat ? m.Total : m.ExVat;

    /// <summary>Price → px from the top of the plot.</summary>
    private double Y(double value) => Top + (_yMax - value) / (_yMax - _yMin) * PlotHeight;

    private static string Px(double value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "px";

    private static string Kr(double value) => value.ToString("0.000") + " kr";

    private void Hover(int index, MouseEventArgs e)
    {
        _hover = index;
        _tipX = e.ClientX;
        _tipY = e.ClientY;
    }

    private void ClearHover() => _hover = -1;
}
