<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    Version (same scheme as CheckYourDanish): Major.Minor is set here by hand; the patch is the
    GitHub Actions run number (passed as -p:BuildNumber=...) and stays 0 for local builds. The SDK
    appends the git commit to InformationalVersion (1.0.42+<sha>), and the build time is stamped
    below. The app reads all of it through BuildInfo.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>

    <MajorMinor>1.0</MajorMinor>
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <Version>$(MajorMinor).$(BuildNumber)</Version>
    <!-- "s" is culture-invariant; a custom format would get the Danish "." time separator. -->
    <BuildDate>$([System.DateTime]::UtcNow.ToString("s"))Z</BuildDate>
    <Authors>Per Hejndorf</Authors>
    <Copyright>© 2026 Per Hejndorf, Kreaton</Copyright>
    <!-- Danish day/month names and number formatting regardless of the browser's language. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildDate</_Parameter1>
      <_Parameter2>$(BuildDate)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Give elforecast.js a content hash in its published file name (index.html refers to it as
    elforecast#[.{fingerprint}].js), so a cached index.html never pairs with a newer script or the
    other way round. The trailing "!" puts the hash in the file name, not only in the endpoint.
    (The same trick for app.css renames the file but leaves the <link> unchanged, so it is not
    used; elforecast.js refreshes app.css itself when it finds a new version.)
  -->
  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="AppJs" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stromligning\Stromligning.csproj" />
  </ItemGroup>

</Project>
