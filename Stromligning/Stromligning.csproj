<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- XML docs ship with the DLL so consumers get IntelliSense; not every member needs one. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>Stromligning</PackageId>
    <Version>1.0.0</Version>
    <Authors>Per Hejndorf</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Client for the stromligning.dk API: Danish electricity prices with full tariff breakdown, spot price forecasts, and CSV/JSON export.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
